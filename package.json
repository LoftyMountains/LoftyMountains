{
  "name": "jingxing-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prepare-pages.mjs && npm run check:bundle",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/prepare-map-worker.mjs",
    "predev": "node scripts/prepare-map-worker.mjs",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle-size.mjs dist"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "hls.js": "^1.6.16",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "6.7.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.17.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "@types/web-bluetooth": "^0.0.21",
    "vitest": "^2.1.9"
  }
}
